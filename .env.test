# Hermetic test environment for `bun test` (prevents accidental writes to a live Firebase project configured in .env)
NODE_ENV=test
DEV_MODE=true
DB_PROVIDER=sqlite
STORAGE_PROVIDER=
FIREBASE_SPARK_MODE=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_REGION=
FIREBASE_CONFIG=
GCLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT=
COOKIE_SECURE=false
SESSION_SECRET=kogane-test-session-secret-0123456789abcdef
ENCRYPTION_KEY=kogane-test-encryption-key-0123456789abcdef
NUXT_PUBLIC_SHARE_ORIGIN=http://localhost:3000
