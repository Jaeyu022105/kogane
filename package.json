{
  "name": "kogane",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev --host 0.0.0.0 --port 3000",
    "dev:lan": "bun --bun nuxt dev --host 0.0.0.0 --port 3000",
    "generate": "bun --bun nuxt generate",
    "preview": "bun --bun nuxt preview --host 0.0.0.0 --port 3000",
    "preview:lan": "bun run .output/server/index.mjs",
    "tunnel": "bunx untun tunnel http://localhost:3000 --qr",
    "allow-firewall": "cmd /c scripts\\allow-lan-port-3000.bat",
    "start": "bun run .output/server/index.mjs",
    "db:reset": "bun run scripts/db-reset.ts",
    "db:seed": "bun run scripts/db-seed.ts",
    "db:backup": "bun run scripts/backup-db.ts",
    "db:restore": "bun run scripts/restore-db.ts",
    "test": "bun test",
    "launch": "bun run scripts/launcher.ts",
    "compile": "bun build --compile scripts/launcher.ts --outfile kogane.exe",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.3.0",
    "@supabase/supabase-js": "^2.49.4",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^3.16.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "typescript": "^5.8.3"
  }
}
