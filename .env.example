# ==============================================================================
# Kogane Restaurant Workstation POS - Configuration Environment (.env)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database & uploads — chosen automatically by lib/backend.ts:
#   Local       SQLite + uploads on local disk (dev-storage/)
#               when DEV_MODE=true, or when no Firebase credentials are set
#   Production  Cloud Firestore, when Firebase credentials (below) are set
#                 uploads: Firestore blobs (<= 700 KB, Spark plan), or Cloud Storage
#                 when FIREBASE_STORAGE_BUCKET is set / running on Google (Blaze plan)
# Overrides (normally leave unset):
#   DB_PROVIDER=sqlite | firebase
#   STORAGE_PROVIDER=local | firestore | firebase
#   FIREBASE_SPARK_MODE=true   (Firebase on Spark: Firestore + Firestore-blob uploads)
# ------------------------------------------------------------------------------
DEV_MODE=true

# Security, Hashing, 2FA Encryption & Session Secrets
# Each must be a random string of 32+ characters, e.g.:  bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Local / single-server installs may leave SESSION_SECRET empty: a private one is generated
# once into .kogane-secret next to the database. Online Firebase servers refuse to start without it.
SESSION_SECRET=
# Dedicated AES-256-GCM key for encrypting TOTP 2FA secrets at rest (uses SESSION_SECRET if empty)
ENCRYPTION_KEY=
# Set COOKIE_SECURE=true when served over HTTPS (Render / Koyeb / bun run tunnel / Firebase Hosting)
COOKIE_SECURE=false
# Number of reverse proxies in front of the server (1 for Render / Koyeb / a tunnel, 2 for Firebase
# App Hosting). Leave empty when visitors connect directly (LAN): X-Forwarded-For is then ignored.
TRUST_PROXY=

# ------------------------------------------------------------------------------
# LAN & Public Origin
# Local LAN example:      http://192.168.1.50:3000
# Free Node PaaS example: https://kogane-pos.onrender.com
# Tunnel example:         https://your-tunnel-subdomain.trycloudflare.com
# ------------------------------------------------------------------------------
NUXT_PUBLIC_SHARE_ORIGIN=http://localhost:3000

# Canonical public site URL for SEO canonical links, sitemap.xml, robots.txt, and llms.txt
# Production example:     https://kogane.app
NUXT_PUBLIC_SITE_URL=

# Search Console verification tokens (optional)
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_BING_SITE_VERIFICATION=

# ------------------------------------------------------------------------------
# Firebase Spark Free-Tier Workarounds (Project: kogane-e7f2b, Region: asia-southeast1)
# Cloud Functions Gen 2, Firebase App Hosting, and Firebase Storage require Blaze billing.
# Cloud Firestore works FREE on Spark! Pair kogane-e7f2b Firestore with either:
#   (a) Free Node PaaS (Render via render.yaml or Koyeb/Fly via Dockerfile, no credit card):
#       DEV_MODE=false, FIREBASE_SPARK_MODE=true, COOKIE_SECURE=true + credentials below
#   (b) Local PC connected online to Spark Firestore + `bun run tunnel` (HTTPS URL & QR):
#       DEV_MODE=false, FIREBASE_SPARK_MODE=true, COOKIE_SECURE=true + credentials below
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=kogane-e7f2b
# Region for Firestore / optional Blaze Functions (e.g., asia-southeast1 or us-central1)
FIREBASE_REGION=asia-southeast1
# Blaze-only (leave commented out on Spark free tier so FirestoreStorageAdapter is used):
# FIREBASE_STORAGE_BUCKET=kogane-e7f2b.firebasestorage.app

# Provide either FIREBASE_SERVICE_ACCOUNT_JSON (raw JSON or base64-encoded JSON)
# OR separate FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY (or ADC on Blaze App Hosting/Functions)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kogane-e7f2b.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
