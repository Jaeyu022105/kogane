# Kogane local development
DEV_MODE=true
DATABASE_URL=./dev.db

# Optional: set this when copied terminal links should use a LAN address.
# Example: http://192.168.1.25:3000
NUXT_PUBLIC_SHARE_ORIGIN=

# Supabase is only used when DEV_MODE=false.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
