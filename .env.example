# ==============================================================================
# Kogane Restaurant Workstation POS - Configuration Environment (.env)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database Engine Mode:
# Set DEV_MODE=true for standalone local SQLite (Recommended for on-premise restaurant LAN).
# Set DEV_MODE=false only if deploying to Cloud Supabase / PostgreSQL.
# ------------------------------------------------------------------------------
DEV_MODE=true

# Security & Session Encryption Secret
# Change this to a secure random string for production deployments
SESSION_SECRET=kogane-restaurant-secret-key-change-this-in-production

# ------------------------------------------------------------------------------
# LAN & Multi-Device Access (Kitchen tablets, Cashier phones, Waiter terminals)
# Set this to the static local IP address of your host counter PC.
# Example: http://192.168.1.50:3000
# ------------------------------------------------------------------------------
NUXT_PUBLIC_SHARE_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Optional Cloud Production Settings (Only required if DEV_MODE=false)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_KEY=your-service-role-key
