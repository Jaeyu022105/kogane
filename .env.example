# ==============================================================================
# Kogane Environment Configuration
# ==============================================================================

# Node / Nuxt Environment ('development' or 'production')
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Engine Mode:
# Set to 'true' for local SQLite storage (development, single-node, or Docker container).
# Set to 'false' for production Supabase / PostgreSQL.
DEV_MODE=true

# Path to SQLite database when DEV_MODE=true
DATABASE_URL=./dev.db

# Share Origin (Optional)
# Set this when copied terminal links should use your server's domain or LAN IP.
# Example: https://kogane.yourdomain.com or http://192.168.1.100:3000
NUXT_PUBLIC_SHARE_ORIGIN=

# ------------------------------------------------------------------------------
# Supabase Production Settings (Required only when DEV_MODE=false)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_KEY=your-service-role-key-bypasses-rls

# Optional: Enterprise tools feature flag
# NUXT_PUBLIC_ENTERPRISE_TOOLS=true
