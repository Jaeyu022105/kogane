{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kogane-dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--bun",
        "nuxt",
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "kogane-dev-stable",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--bun",
        "nuxt",
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000,
      "env": {
        "KOGANE_RELEASE_CHANNEL": "stable"
      }
    },
    {
      "name": "kogane-preview",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        ".output/server/index.mjs"
      ],
      "port": 3000
    }
  ]
}
